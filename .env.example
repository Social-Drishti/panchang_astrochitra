# Copy to .env.local and fill in. NEVER commit .env.local.
# Used at build/dev time by Vite (VITE_* exposes it to client code).
# For a production deployment, route credentials through a server-side proxy
# instead of the browser bundle.
VITE_GEMINI_API_KEY=
# https://platform.deepseek.com/api_keys — used by the DeepSeek Chat / Reasoner models.
VITE_DEEPSEEK_API_KEY=
# https://api.experientiallabs.ai — used by the Gemma 4 31B IT / Qwen models (Explabs).
VITE_EXPLABS_API_KEY=
# Route Explabs requests through a server-side proxy to avoid browser CORS
# (ExperientialLabs blocks direct browser calls). In dev the Vite dev server
# proxies automatically; set this only when a prod backend proxy is needed.
VITE_EXPLABS_PROXY=
# Panchang PHP backend. In dev the Vite proxy sends /api/v1 to localhost:1212.
# Point this at your backend path in production. Leave empty to use /api/v1.
VITE_API_BASE=

# --- Server-side only (no VITE_ prefix on purpose: never inlined into the bundle) ---
# Astrochitra Slots external API. Used by the PHP backend to create consultation
# leads and read a client's appointments. Manage the key at
# https://slots.astrochitra.com/admin/api-keys (name: "For APP").
# Needs permissions: leads.create, clients.read, appointments.read
ASTROCHITRA_API_KEY=
# Leave empty to use the production default.
ASTROCHITRA_API_BASE=
# Seconds to wait on an upstream call. Lead creation can synchronously generate a
# birth chart, which takes up to ~60s when birth details are supplied.
ASTROCHITRA_API_TIMEOUT=90
# Seconds a synced consultation snapshot stays fresh. Each sync costs one upstream
# call against a per-hour rate limit, so raising this lets more users share the key.
ASTROCHITRA_SYNC_TTL=900
# Stamped on leads so they can be told apart in the slots admin panel.
ASTROCHITRA_LEAD_REFERENCE=pwa_consultation
